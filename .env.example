# ==============================================================================
# TerraCast-NER: Unified Environment Configuration Template
# Problem Statement ID: 26001 (MDoNER - Smart India Hackathon)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE PERSISTENCE, REALTIME & AUTH
# ------------------------------------------------------------------------------
# Obtained from your Supabase Project Settings -> API & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# PostgreSQL connection string (Transaction pooler on port 6543 or direct on 5432)
# Format: postgresql+asyncpg://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET_FIELD_REPORTS=field-reports
SUPABASE_STORAGE_BUCKET_SAR=sar-rasters

# ------------------------------------------------------------------------------
# 2. 3D GIS & MAP VISUALIZATION TOKENS
# ------------------------------------------------------------------------------
# Mapbox token for 2D/3D vector tiles & satellite imagery drape
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0.your-signature-here
# Optional: Cesium Ion token for 3D world terrain
NEXT_PUBLIC_CESIUM_TOKEN=your-cesium-ion-token-here

# ------------------------------------------------------------------------------
# 3. BACKEND API & SECURITY
# ------------------------------------------------------------------------------
PROJECT_NAME="TerraCast-NER Engine"
API_V1_STR="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=terracast-super-secure-production-key-change-in-prod-32bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://terracast.ner.gov.in"]

# ------------------------------------------------------------------------------
# 4. REDIS & CELERY ASYNC WORKERS
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ------------------------------------------------------------------------------
# 5. OSRM TRANSIT & SAFE CORRIDOR ROUTING
# ------------------------------------------------------------------------------
OSRM_BACKEND_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 6. REMOTE SENSING & WEATHER TELEMETRY FEEDS
# ------------------------------------------------------------------------------
# Google Earth Engine (GEE) for Sentinel-1 C-band and NISAR InSAR deformation
GEE_PROJECT_ID=your-google-cloud-project-id
GEE_SERVICE_ACCOUNT_EMAIL=terracast-gee@your-gcp-project.iam.gserviceaccount.com
GEE_SERVICE_ACCOUNT_KEY_FILE=./credentials/gee-service-account.json

# NASA Earthdata API (GPM IMERG Early/Late precipitation feeds)
NASA_EARTHDATA_TOKEN=your-nasa-bearer-token
IMD_AWS_GRID_URL=https://api.imd.gov.in/gridded/rainfall

# ------------------------------------------------------------------------------
# 7. TELEPHONY SIP TRUNKING & MULTI-LINGUAL IVRS
# ------------------------------------------------------------------------------
TELECOM_SIP_GATEWAY_URL=https://api.exotel.com/v1/Accounts/your_sid
TELECOM_API_KEY=your-telecom-api-key
TELECOM_API_SECRET=your-telecom-api-secret
EMERGENCY_DISPATCH_CLI=08047190000
CDN_STATIC_URL=https://your-project-id.supabase.co/storage/v1/object/public/static-assets
